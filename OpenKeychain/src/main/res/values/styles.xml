<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="CardViewHeader">
        <item name="android:drawableBottom">?attr/cardViewHeaderDrawable</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/colorHeaderText</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="CardViewActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">@color/card_view_button</item>
    </style>

    <style name="SectionHeader">
        <item name="android:drawableBottom">?attr/sectionHeaderDrawable</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorHeaderText</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FabMenuStyle">
        <item name="android:background">?attr/fabLabelBackgroundDrawable</item>
        <item name="android:textColor">?attr/colorFabText</item>
    </style>

    <!-- This style is for use with our drag and drop RecyclerView since ItemDecoration did not
    move with the drag -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <style name="MaterialFlatButton" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">?attr/colorAccent</item>
    </style>

    <!-- constrain size of backup code input for smaller devices -->

    <style name="TransferCodeTextBase">
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:hint">1234</item>
        <item name="android:maxLength">4</item>
        <item name="android:textColorHint">@android:color/transparent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">42sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textColor">?attr/colorHeaderText</item>
        <item name="android:inputType">numberPassword|textVisiblePassword</item>
    </style>

    <style name="TransferCodeText" parent="TransferCodeTextBase">
        <item name="android:textColor">?attr/colorHeaderText</item>
    </style>

    <style name="TransferCodeTextSep" parent="TransferCodeText">
        <item name="android:hint"></item>
        <item name="android:text">-</item>
    </style>

    <style name="DebugButton" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableRight">@drawable/ic_folder_grey_24dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">?android:attr/listPreferredItemHeight</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
    </style>

    <style name="Widget.Keychain.Spinner.DropDown.ActionBar"
        parent="Widget.AppCompat.Light.Spinner.DropDown.ActionBar">

        <item name="android:popupBackground">?attr/colorCardViewBackground</item>
        <item name="android:textColor">?attr/colorText</item>

    </style>

    <style name="Widget.Keychain.AutoCompleteTextView"
        parent="Widget.AppCompat.Light.AutoCompleteTextView">

        <item name="android:popupBackground">?attr/colorCardViewBackground</item>
        <item name="android:textColor">?attr/colorText</item>

    </style>

    <style name="ThemeOverlay.KeyChain.Popup.Light"
        parent="ThemeOverlay.AppCompat.Light">

        <item name="android:textColor">?attr/colorText</item>
        <item name="android:popupBackground">?attr/colorPrimary</item>
        <item name="colorBackground">?attr/colorPrimary</item>
    </style>

    <style name="ThemeOverlay.KeyChain.Popup.Dark"
        parent="ThemeOverlay.AppCompat.Dark">

        <item name="android:textColor">?attr/colorText</item>
        <item name="android:popupBackground">?attr/colorPrimary</item>
        <item name="colorBackground">?attr/colorPrimary</item>
    </style>

    <style name="ThemeOverlay.KeyChain.ActionBar"
        parent="ThemeOverlay.AppCompat.Dark.ActionBar">

        <item name="colorControlNormal">?attr/colorIcon</item>
        <item name="android:textColor">?attr/colorText</item>
        <item name="android:textColorPrimary">?attr/colorText</item>
        <item name="colorBackground">?attr/colorPrimary</item>
        <item name="background">?attr/colorPrimary</item>

    </style>


    <style name="TextAppearance.Keychain.Headline" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textColor">?attr/colorText</item>
        <item name="android:textColorHint">?android:textColorHint</item>
        <item name="android:textColorHighlight">?android:textColorHighlight</item>
        <item name="android:textColorLink">?android:textColorLink</item>
        <item name="android:textSize">18sp</item>
    </style>

</resources>
