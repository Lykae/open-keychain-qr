<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.Keychain.Light" parent="Theme.AppCompat.Light">

        <!-- Primary -->
        <item name="colorPrimary">#d1d1d1</item>
        <item name="colorPrimaryDark">#263238</item>
        <item name="colorAccent">#00897B</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">#FAFAFA</item>
        <item name="android:colorBackground">#FAFAFA</item>

        <!-- Toolbar -->
        <item name="colorBrightToolbar">#FFFFFF</item>
        <item name="colorToolbar">#d1d1d1</item>

        <!-- Floating Action Button -->
        <item name="colorFab">#00897B</item>
        <item name="colorFabPressed">#00695C</item>
        <item name="colorFabText">#FFFFFF</item>
        <item name="fabLabelBackgroundDrawable">@drawable/fab_label_background</item>

        <!-- Tabs -->
        <item name="colorTabText">#80000000</item>
        <item name="colorTabTextSelected">#212121</item>
        <item name="colorTabIndicator">#00897B</item>

        <!-- Content -->
        <item name="colorEmphasis">#00897B</item>
        <item name="colorButtonRow">#FFFFFFFF</item>

        <item name="colorLogBackground">#FAFAFA</item>
        <item name="colorCardViewBackground">#FFFFFF</item>

        <item name="cardViewHeaderDrawable">@drawable/cardview_header</item>
        <item name="colorIcon">#212121</item>
        <item name="popupOverlayStyle">@style/ThemeOverlay.KeyChain.Popup.Light</item>

        <!-- Text -->
        <item name="colorText">#212121</item>
        <item name="colorHeaderText">#37474F</item>
        <item name="colorTertiaryText">#757575</item>

        <item name="android:textColorPrimary">#212121</item>
        <item name="android:textColorSecondary">#757575</item>
        <item name="actionMenuTextColor">#212121</item>

        <item name="sectionHeaderDrawable">@drawable/section_header_light</item>

        <!-- Window -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowActionModeOverlay">true</item>

        <item name="searchViewStyle">@style/Widget.Keychain.SearchView</item>

        <!-- Dialog -->
        <item name="alertDialogTheme">@style/Theme.Keychain.Light.Dialog.Alert</item>

    </style>

    <style name="Base.Theme.Keychain.Dark" parent="MaterialDrawerTheme.ActionBar">

        <!-- Primary -->
        <item name="colorPrimary">#1E1E1E</item>
        <item name="colorPrimaryDark">#121212</item>
        <item name="colorAccent">#00BFA5</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">#121212</item>
        <item name="android:colorBackground">#121212</item>

        <!-- Toolbar -->
        <item name="colorBrightToolbar">#FFFFFF</item>
        <item name="colorToolbar">#1f1f1f</item>

        <!-- Floating Action Button -->
        <item name="colorFab">#00BFA5</item>
        <item name="colorFabPressed">#008577</item>
        <item name="colorFabText">#FFFFFF</item>
        <item name="fabLabelBackgroundDrawable">@drawable/fab_label_background</item>

        <!-- Tabs -->
        <item name="colorTabText">#80FFFFFF</item>
        <item name="colorTabTextSelected">#FFFFFF</item>
        <item name="colorTabIndicator">#00BFA5</item>

        <!-- Content -->
        <item name="colorEmphasis">#00BFA5</item>
        <item name="colorButtonRow">#1E1E1E</item>

        <item name="colorLogBackground">#121212</item>
        <item name="colorCardViewBackground">#1E1E1E</item>

        <item name="cardViewHeaderDrawable">@drawable/cardview_header</item>
        <item name="colorIcon">#FFFFFF</item>
        <item name="popupOverlayStyle">@style/ThemeOverlay.KeyChain.Popup.Dark</item>

        <!-- Text -->
        <item name="colorText">#FFFFFF</item>
        <item name="colorHeaderText">#FFFFFF</item>
        <item name="colorTertiaryText">#B0B0B0</item>

        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0B0B0</item>
        <item name="actionMenuTextColor">#FFFFFF</item>

        <item name="sectionHeaderDrawable">@drawable/section_header_dark</item>

        <!-- Drawer -->
        <item name="material_drawer_selected_text">#00BFA5</item>

        <!-- Window -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowActionModeOverlay">true</item>

        <item name="searchViewStyle">@style/Widget.Keychain.SearchView</item>

        <!-- Dialog -->
        <item name="alertDialogTheme">@style/Theme.Keychain.Dark.Dialog.Alert</item>

    </style>


    <!-- Theme aliases -->

    <style name="Theme.Keychain.Light"
        parent="Base.Theme.Keychain.Light" />

    <style name="Theme.Keychain.Dark"
        parent="Base.Theme.Keychain.Dark" />


    <!-- SearchView -->

    <style name="Widget.Keychain.SearchView"
        parent="Widget.AppCompat.SearchView">

        <item name="closeIcon">@drawable/ic_close_white_24dp</item>

    </style>


    <!-- Dialogs -->

    <style name="Theme.Keychain.Light.Dialog.Alert"
        parent="Base.Theme.AppCompat.Light.Dialog.Alert">

        <item name="colorAccent">#00897B</item>

    </style>


    <style name="Theme.Keychain.Dark.Dialog.Alert"
        parent="Base.Theme.AppCompat.Dialog.Alert">

        <item name="colorAccent">#00BFA5</item>
        <item name="android:windowBackground">#121212</item>

    </style>


    <style name="Theme.Keychain.Light.Dialog"
        parent="Theme.AppCompat.Light.Dialog.MinWidth">

        <item name="colorAccent">#00897B</item>
        <item name="android:buttonStyle">@style/MaterialFlatButton</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

    </style>


    <style name="Theme.Keychain.Dark.Dialog"
        parent="Theme.AppCompat.Dialog.MinWidth">

        <item name="colorAccent">#00BFA5</item>
        <item name="android:buttonStyle">@style/MaterialFlatButton</item>

        <item name="android:windowBackground">#121212</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

    </style>


    <!-- Transparent -->

    <style name="Theme.Keychain.AppCompat.Transparent"
        parent="Theme.AppCompat.Light">

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>

    </style>


    <style name="Theme.Keychain.AppCompat.Transparent.Fullscreen"
        parent="Theme.Keychain.AppCompat.Transparent">

        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>

    </style>


    <style name="Theme.Keychain.Transparent"
        parent="Theme.Keychain.AppCompat.Transparent" />

</resources>